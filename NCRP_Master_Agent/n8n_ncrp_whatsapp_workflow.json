{
  "name": "NCRP Cyber Crime Notice Automation (WhatsApp to Agent)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ncrp-whatsapp",
        "options": {}
      },
      "id": "1",
      "name": "WhatsApp Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "ncrp-whatsapp-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.message || $json.body.text || $json.body.body || '' }}",
              "operation": "contains",
              "value2": ".pdf"
            },
            {
              "value1": "={{ $json.body.mediaUrl || $json.body.documentUrl || '' }}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "combineOperation": "any"
      },
      "id": "2",
      "name": "Check if PDF Uploaded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://buildings-measures-probably-emphasis.trycloudflare.com/webhook/whatsapp",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify($json.body) }}"
      },
      "id": "3",
      "name": "Forward to NCRP Master Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        700,
        200
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://buildings-measures-probably-emphasis.trycloudflare.com/webhook/whatsapp",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify($json.body) }}"
      },
      "id": "4",
      "name": "Handle Text/Selection Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        700,
        400
      ]
    }
  ],
  "connections": {
    "WhatsApp Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check if PDF Uploaded",
            "type": "main",
            "index": 0
          }
